<!DOCTYPE html>
<html lang="{{ metaLanguage }}" data-bs-theme="{{ defaultLayoutMode == 'auto' ? 'light' : defaultLayoutMode }}"
      data-pmf-default-theme="{{ defaultLayoutMode|default('auto') }}"
      data-pmf-allow-user-theme="{{ allowUserLayoutMode is defined and allowUserLayoutMode ? 'true' : 'false' }}">
<head>
  <meta charset="utf-8">

  <title>{{ title }}</title>
  <base href="{{ baseHref }}">

  <meta content="{{ metaDescription }}" name="description">
  <meta content="{{ metaPublisher }}" name="author">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <meta content="{{ header }}" name="application-name">
  <meta content="#b4d567" name="theme-color">
  <meta content="{{ metaRobots }}" name="robots">
  <meta content="7 days" name="revisit-after">

  {% if isDebugEnabled %}<link href="{{ baseHref }}{{ asset('assets/public/debugMode.css') }}" rel="stylesheet">{% endif %}

  <link href="{{ baseHref }}{{ asset('assets/public/styles.css') }}" rel="stylesheet" media="screen">
  <link href="{{ baseHref }}{{ asset('assets/templates/' ~ tplSetName ~ '/theme.css') }}" rel="stylesheet" media="screen">
  {% if customCss is not empty %}
  <style media="screen">
    {{ customCss | raw }}
  </style>
  {% endif %}
  {% if pluginStylesheets is defined and pluginStylesheets is not empty %}
    {% for stylesheet in pluginStylesheets %}
  <link href="{{ baseHref }}{{ stylesheet }}" rel="stylesheet" media="screen">
    {% endfor %}
  {% endif %}
  <link href="{{ baseHref }}assets/images/mailvio/favicon.ico" rel="icon" type="image/x-icon">
  <link href="{{ baseHref }}assets/images/mailvio/favicon-32x32.png" rel="icon" type="image/png" sizes="32x32">
  <link href="{{ baseHref }}assets/images/mailvio/favicon-16x16.png" rel="icon" type="image/png" sizes="16x16">
  <link href="{{ baseHref }}assets/images/mailvio/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180">
  <link href="{{ currentPageUrl }}" rel="canonical">

  {% if richSnippetsEnabled %}
  {% block richSnippets %}{% endblock %}
  {% endif %}

</head>
<body class="pmf-page-wrapper pmf-template-{{ tplSetName }}" dir="{{ dir }}">

<header class="mv-nav sticky-top">
  <nav class="navbar navbar-expand-lg py-3" aria-label="Main">
    <div class="container-xxl px-4">
      <a class="navbar-brand mv-brand" href="{{ faqHome }}" title="{{ header }}">
        <span class="mv-logo"><span class="mv-logo-mail">mail</span><span class="mv-logo-vio">vio</span></span>
        <span class="mv-brand-divider" aria-hidden="true"></span>
        <span class="mv-brand-label">Knowledge Center</span>
      </a>
      <button class="navbar-toggler mv-nav-toggler" type="button" data-bs-toggle="collapse"
              data-bs-target="#pmf-top-navbar" aria-controls="pmf-top-navbar" aria-expanded="false"
              aria-label="Toggle navigation">
        <i class="bi bi-list" aria-hidden="true"></i>
      </button>

      <div class="collapse navbar-collapse" id="pmf-top-navbar">
        <ul class="navbar-nav mx-lg-auto mb-3 mb-lg-0 gap-lg-2">
          {% if not isMaintenanceMode %}
            {% for item in topNavigation %}
              <li class="nav-item">
                <a class="nav-link mv-nav-link {{ item['active'] }}" href="{{ item['link'] }}">{{ item['name'] }}</a>
              </li>
            {% endfor %}
          {% endif %}
        </ul>

        <div class="mv-nav-actions">
          {% if allowUserLayoutMode %}
          <div class="btn-group pmf-theme-switcher border" role="group" aria-label="{{ 'msgToggleTheme' | translate }}">
            <button type="button" class="btn btn-link nav-link py-2 px-2" id="theme-light"
                    aria-label="Light mode" title="Light mode">
              <i class="bi bi-sun-fill"></i>
            </button>
            <button type="button" class="btn btn-link nav-link py-2 px-2" id="theme-dark"
                    aria-label="Dark mode" title="Dark mode">
              <i class="bi bi-moon-stars-fill"></i>
            </button>
            <button type="button" class="btn btn-link nav-link py-2 px-2" id="theme-high-contrast"
                    aria-label="High contrast mode" title="High contrast mode">
              <i class="bi bi-circle-half"></i>
            </button>
          </div>
          {% endif %}
          <div class="dropdown">
            <button type="button" class="btn mv-account-toggle dropdown-toggle" data-bs-toggle="dropdown"
                    aria-expanded="false" data-bs-display="static" title="{{ msgLoginUser }}"
                    aria-label="{{ msgLoginUser }}">
              <i class="bi bi-person-circle" aria-hidden="true"></i>
              <span class="d-lg-none ms-1" aria-hidden="true">{{ msgLoginUser }}</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              {% if not isUserLoggedIn %}
                {% if isUserRegistrationEnabled %}
                  <li><a class="dropdown-item" href="./user/register">{{ 'msgRegisterUser' | translate }}</a></li>
                {% endif %}
                <li><a class="dropdown-item" href="./login">{{ msgLoginUser }}</a></li>
              {% else %}
                <li><a class="dropdown-item" href="./user/ucp">{{ msgUserControlDropDown }}</a></li>
                <li><a class="dropdown-item" href="./user/bookmarks">{{ msgBookmarks }}</a></li>
                <li>
                  <a class="dropdown-item d-flex align-items-center" href="./user/chat">
                    {{ 'msgChat' | translate }}
                    {% if unreadChatCount is defined and unreadChatCount > 0 %}
                      <span class="badge bg-danger ms-auto">{{ unreadChatCount }}</span>
                    {% endif %}
                  </a>
                </li>
                <li><a class="dropdown-item" href="./user/request-removal">{{ msgUserRemoval }}</a></li>
                <li><hr class="dropdown-divider"></li>
                {% if isUserHasAdminRights %}
                  <li><a class="dropdown-item" href="./admin">{{ msgAdmin }}</a></li>
                {% endif %}
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="./logout?csrf={{ csrfLogout }}">{{ msgLogoutUser }}</a></li>
              {% endif %}
            </ul>
          </div>
          <a class="mv-nav-link mv-nav-plain" href="https://mailvio.com">mailvio.com</a>
          <a class="btn btn-primary mv-cta" href="https://app.mailvio.com/login">Log in to Mailvio</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<!-- HERO + SEARCH -->
{% set isSearchPage = (currentPageUrl matches '/\\/search\\.html([?#]|$)/') or (currentPageUrl matches '/[?&]action=search(&|$)/') %}
{% if not isMaintenanceMode and not isSearchPage %}
<section class="mv-hero {% block heroModifier %}mv-hero--compact{% endblock %}">
  <div class="mv-hero-bg" style="background-image: url('{{ baseHref }}assets/images/mailvio/hero-background.jpg')"
       aria-hidden="true"></div>
  <div class="mv-hero-overlay" aria-hidden="true"></div>
  <div class="container-xxl px-4 position-relative">
    <div class="mv-hero-inner">
      {% block heroHeading %}{% endblock %}
      <div class="search mv-search">
        <form action="./search.html" id="search" method="get" role="search">
          <i class="bi bi-search"></i>
          <input autocomplete="off" type="text" class="form-control form-control-lg" id="pmf-search-autocomplete"
                 name="search" placeholder="{{ searchBox }} ..." maxlength="255" value="{{ searchTerm }}">
          <kbd class="pmf-search-hint" id="pmf-search-hint" aria-hidden="true"></kbd>
          <button type="submit" class="btn btn-primary btn-lg">{{ searchBox }}</button>
        </form>
      </div>
      <a class="mv-hero-link" href="./search.html">{{ msgAdvancedSearch }} <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      {% block heroFooter %}{% endblock %}
    </div>
  </div>
</section>
{% endif %}

<!-- MAIN CONTENT -->
<section class="mv-main{% if isSearchPage %} mv-main--search{% endif %}" id="wrapper">
  <div class="container">
  {% if not isMaintenanceMode %}
    {% block content %}{% endblock %}
  {% else %}
    We're currently in maintenance mode. Please come back later.
  {% endif %}
  </div>
</section>

<footer class="mv-footer">
  <div class="container-xxl px-4">
    <div class="row g-5 mv-footer-main">
      <div class="col-lg-4">
        <a class="mv-logo mv-logo--footer" href="https://mailvio.com">
          <span class="mv-logo-mail">mail</span><span class="mv-logo-vio">vio</span>
        </a>
        <p class="mv-footer-text">
          The email deliverability platform that turns email marketing into predictable revenue growth.
          Find answers, guides and best practices in our Knowledge Center.
        </p>
        <a class="mv-footer-support" href="./contact.html">
          <i class="bi bi-chat-dots" aria-hidden="true"></i> Contact Support
        </a>
      </div>

      <div class="col-6 col-md-3 col-lg-2">
        <h4 class="mv-footer-heading">Help Center</h4>
        <ul class="mv-footer-links">
          {% if not isMaintenanceMode %}
            {% for item in footerNavigation %}
              <li><a href="{{ item['link'] }}" class="{{ item['active'] }}">{{ item['name'] }}</a></li>
            {% endfor %}
            {% if isImprintLinkEnabled %}
              <li><a target="_blank" href="./imprint.html">{{ msgImprint }}</a></li>
            {% endif %}
            {% if isAccessibilityStatementEnabled %}
              <li><a target="_blank" href="./accessibility.html">{{ msgAccessibilityStatement }}</a></li>
            {% endif %}
            {% if isCookieConsentEnabled %}
              <li><a id="showCookieConsent" href="#">{{ cookiePreferences }}</a></li>
            {% endif %}
          {% endif %}
        </ul>
      </div>

      <div class="col-6 col-md-3 col-lg-2">
        <h4 class="mv-footer-heading">Product</h4>
        <ul class="mv-footer-links">
          <li><a href="https://mailvio.com/done-for-you-warm-up">DFY Warm-up</a></li>
          <li><a href="https://mailvio.com/ai-email-writer">AI Email Writing</a></li>
          <li><a href="https://mailvio.com/transparency">100% Transparency</a></li>
          <li><a href="https://mailvio.com/lead-loss-prevention-system">Lead Loss Prevention</a></li>
          <li><a href="https://mailvio.com/3-wave-sending">Automatic 3-Wave Sending</a></li>
          <li><a href="https://mailvio.com/in-house-deliverability-team">Your Inbox Placement Expert Team</a></li>
        </ul>
      </div>

      <div class="col-6 col-md-3 col-lg-2">
        <h4 class="mv-footer-heading">Resources</h4>
        <ul class="mv-footer-links">
          <li><a href="https://mailvio.com/blog">Blog</a></li>
          <li><a href="https://mailvio.com/email-deliverability-course">Free Email Deliverability Course</a></li>
          <li><a href="https://mailvio.com/email-marketing-skills">Test your Email Marketing Skills (Quiz)</a></li>
          <li><a href="https://mailvio.com/feature-freakz">Feature Freakz</a></li>
          <li><a href="https://mailvio.com/academy">Mailvio Academy</a></li>
        </ul>
      </div>

      <div class="col-6 col-md-3 col-lg-2">
        <h4 class="mv-footer-heading">Company</h4>
        <ul class="mv-footer-links">
          <li><a href="https://mailvio.com/about-us">About us</a></li>
          <li><a href="https://mailvio.com/partner-program">Partner Program</a></li>
          <li><a href="https://mailvio.com/careers">Careers</a></li>
          <li><a href="https://mail.mailvio.com/apidocs" target="_blank" rel="noopener noreferrer">API</a></li>
        </ul>
      </div>
    </div>

    <div class="mv-footer-bottom">
      <div>© {{ currentYear }} Mailvio. All rights reserved. | Built for email marketers, by email marketers.</div>
      <div class="mv-footer-legal">
        <a href="https://mailvio.com/privacy">Privacy Policy</a>
        <a href="https://mailvio.com/tos">Terms of Service</a>
        <a href="https://mailvio.com/disclaimer">Disclaimer</a>
        <a href="https://mailvio.com/anti-spam">Anti-spam Policy</a>
        <span><i class="bi bi-globe2" aria-hidden="true"></i> Global Email Delivery</span>
      </div>
    </div>
  </div>
</footer>

<!-- Push notification opt-in banner -->
{% if pushEnabled and isUserLoggedIn %}
<div id="pmf-push-banner" class="position-fixed bottom-0 start-0 end-0 d-none" style="z-index: 1050;" data-pmf-csrf="{{ csrfTokenPushSubscription }}">
  <div class="container">
    <div class="alert alert-info alert-dismissible shadow-lg mb-0 rounded-0 rounded-top d-flex align-items-center" role="alert">
      <i class="bi bi-bell fs-4 me-3 flex-shrink-0" aria-hidden="true"></i>
      <div class="flex-grow-1">
        <strong>{{ 'msgPushNotifications' | translate }}</strong>
        <span class="ms-1 d-none d-md-inline">{{ 'msgPushNotificationsDescription' | translate }}</span>
      </div>
      <button type="button" class="btn btn-primary btn-sm ms-3 flex-shrink-0" id="pmf-push-banner-enable">
        {{ 'msgPushNotificationsEnable' | translate }}
      </button>
      <button type="button" class="btn-close ms-2 flex-shrink-0" id="pmf-push-banner-dismiss" aria-label="Close"></button>
    </div>
  </div>
</div>
{% endif %}

<!-- Frontend toasts -->
<div class="toast-container position-fixed top-0 start-50 translate-middle-x mt-5 p-3">
  <div id="pmf-notification" class="toast align-items-center text-bg-success shadow border-0" role="alert"
       aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="pmf-notification-message">
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close">
      </button>
    </div>
  </div>

  <div id="pmf-notification-error" class="toast align-items-center text-bg-danger shadow border-0" role="alert"
       aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="pmf-notification-error-message">
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close">
      </button>
    </div>
  </div>
</div>

{% if isCookieConsentEnabled %}
<script type="module" src="./{{ asset('assets/public/cookieConsent.js') }}"></script>
{% endif %}
{% if pluginScripts is defined and pluginScripts is not empty %}
  {% for script in pluginScripts %}
<script src="{{ baseHref }}{{ script }}"></script>
  {% endfor %}
{% endif %}
<script type="module" src="./{{ asset('assets/public/frontend.js') }}"></script>
{% if successMessage or errorMessage %}
<script type="module">
  import { pushNotification, pushErrorNotification } from './{{ asset('assets/public/notifications.js') }}';
  {% if successMessage %}
  pushNotification('{{ successMessage|e('js') }}');
  {% endif %}
  {% if errorMessage %}
  pushErrorNotification('{{ errorMessage|e('js') }}');
  {% endif %}
</script>
{% endif %}
</body>
</html>
